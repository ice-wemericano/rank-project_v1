# 로컬 실측용 환경변수 예시.
# 사용: 이 파일을 레포 루트의 .env 로 복사한 뒤 `go run .` (앱이 godotenv 로 .env 를 읽음).
#   cp deploy/local/env.local.example .env
# (.env 는 .gitignore 에 있어 커밋되지 않는다.)

SERVER_PORT=9090

# HMAC 서명 키(쿠키/열람증명/디바이스 토큰). 로컬 전용 아무 값.
SECRET_KEY=local-dev-secret-change-me

# 로컬 MySQL (deploy/local/docker-compose.yml)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=rank
DB_PASSWORD=rankpw
DB_NAME=rankdb

# REDIS_ADDR 를 비워 두면 메모리 저장소 사용(운영 Redis 6379 안 건드림).
# REDIS_ADDR=
